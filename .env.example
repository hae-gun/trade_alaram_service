# 로컬 Docker Compose 실행 예시 환경변수입니다.
# 실제 값은 .env 파일에 작성하고 Git에는 포함하지 않습니다.

DB_NAME=tradealarm
DB_SCHEMA=tradealarm_app
DB_USERNAME=tradealarm_app
DB_PASSWORD=tradealarm_app

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

KIS_ENABLED=false
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_APP_KEY=
KIS_APP_SECRET=

MARKET_PRICE_REFRESH_DELAY_MS=60000
MARKET_PRICE_INITIAL_DELAY_MS=30000
MARKET_PRICE_REQUEST_DELAY_MS=1500
MARKET_PRICE_ERROR_BACKOFF_MS=5000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
