# 로컬 Docker Compose 실행 예시 환경변수입니다.
# 실제 값은 .env 파일에 작성하고 Git에는 포함하지 않습니다.

DB_NAME=tradealarm
DB_SCHEMA=tradealarm_app
DB_USERNAME=tradealarm_app
DB_PASSWORD=tradealarm_app

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

KIS_ENABLED=false
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_APP_KEY=
KIS_APP_SECRET=

KAKAO_AUTH_BASE_URL=https://kauth.kakao.com
KAKAO_API_BASE_URL=https://kapi.kakao.com
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback

MARKET_PRICE_REFRESH_DELAY_MS=60000
MARKET_PRICE_INITIAL_DELAY_MS=30000
MARKET_PRICE_REQUEST_DELAY_MS=1500
MARKET_PRICE_ERROR_BACKOFF_MS=5000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# CI/CD에서 푸시된 이미지를 로컬에서 실행할 때 사용하는 값입니다.
# IMAGE_TAG는 develop 또는 develop-{commit-sha} 형식을 사용할 수 있습니다.
IMAGE_TAG=develop
BACKEND_IMAGE=ghcr.io/hae-gun/trade_alaram_service-backend:develop
FRONTEND_IMAGE=ghcr.io/hae-gun/trade_alaram_service-frontend:develop

# 멀티 아키텍처 이미지가 아직 푸시되지 않았거나 Apple Silicon Mac에서 amd64 이미지를 강제 실행할 때 사용합니다.
# DOCKER_PLATFORM=linux/amd64
